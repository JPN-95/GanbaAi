<div class="container">

  <div class="container pt-4 d-flex">
    <div class="col-4 justify-content-between">
      <h1> <%= @test.title %> </h1>
      <h2> <%= @test.level %> : <%= @test.category %> </h2>
    </div>
  </div>

  <% if @test.complete? %>
    <% @test.questions.each_with_index do |q, index| %>
      <div class="card h-100 border-0 shadow-sm rounded-4 transition-card bg-white mt-4"
        style="border-top: 6px solid <%= q.correct? ? '#1A936F' : '#A31621' %> !important;">

        <div class="card-body p-4 text-dark">

          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Question <%= index + 1 %>
          </h6>
          <h4 class="fw-bold text-dark mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4;">
            <%= q.question %>
          </h4>
          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Correct answer
          </h6>
          <h4 class="fw-bold text-dark mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4;">
            <%= q.correct_answer %>
          </h4>
          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Your answer
          </h6>
          <% if q.correct? %>
            <h4 class="fw-bold mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4 letter-spacing: 1px; color: #1A936F;">
          <% else %>
            <h4 class="fw-bold mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4 letter-spacing: 1px; color: #A31621;">
          <% end %>
            <%= q.user_answer %>
          </h4>
          <div class="pt-3 border-top border-light mt-auto">

          </div>
        </div>
      </div>
    <% end %>
  <% else %>
      <div id="questionControls" class="carousel carousel-dark slide" data-ride="carousel">
        <div class="card h-100 border-0 shadow-sm rounded-4 transition-card bg-white mt-4"
        style="border-top: 6px solid #1A70C0 !important;">
          <div class="card-body p-4 text-dark">

          <div class="carousel-inner">
            <% @test.questions.each_with_index do |q, index| %>
              <% if index == 0 %>
                <div class="carousel-item active">
              <% else %>
                <div class="carousel-item">
              <% end %>
                <%= render "questions/form", test: @test, question: q %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#questionControls" data-bs-slide="prev", style= "height: 200px">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#questionControls" data-bs-slide="next", style= "color: black; height: 200px">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
      </div>
    <%= link_to "Submit my test", test_path(@test), class: "btn btn-success mt-3 mb-3 ms-3"%>

  <% end %>

  <%= link_to "Back to all tests", tests_path, class: "btn btn-primary mt-3 mb-3 ms-3"%>

</div>

<style>
  .test-card:first-child {
    display: block !important;
  }
  .carousel-control-prev-icon {
    background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23000' viewBox='0 0 8 8'%3E%3Cpath d='M5.25 0l-4 4 4 4 1.5-1.5-2.5-2.5 2.5-2.5-1.5-1.5z'/%3E%3C/svg%3E") !important;
  }

  .carousel-control-next-icon {
    background-image: url("data:image/svg+xml;charset=utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23000' viewBox='0 0 8 8'%3E%3Cpath d='M2.75 0l-1.5 1.5 2.5 2.5-2.5 2.5 1.5 1.5 4-4-4-4z'/%3E%3C/svg%3E") !important;
  }

</style>
