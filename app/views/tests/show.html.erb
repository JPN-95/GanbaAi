<div class="container">

  <h1> Hello from Test Show </h1>

  <%= @test.title %>
  <%= @test.category %>

  <% if @test.complete? %>
    Test complete
  <% else %>
    Test incomplete
    <% @test.questions.each do |q| %>
      <div class="card">
        <%= render "questions/edit" %>
      </div>
    <% end %>
  <% end %>
</div>
