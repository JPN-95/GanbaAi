<div class="container">

  <div class="container pt-4 d-flex">
    <div class="col justify-content-end">
      <h1> <%= @test.title %> </h1>
      <h2> <%= @test.level %> : <%= @test.category %> </h2>
    </div>

    <div class="col">
      <%= link_to "Back to all tests", tests_path, class: "btn btn-primary"%>
    </div>
  </div>

  <% if @test.complete? %>
    <% @test.questions.each_with_index do |q, index| %>
      <div class="card h-100 border-0 shadow-sm rounded-4 transition-card bg-white mt-4"
        style="border-top: 6px solid <%= q.correct? ? '#81A936' : '#A31621' %> !important;">

        <div class="card-body p-4 text-dark">
          <div class="d-flex justify-content-between align-items-center mb-4">

          </div>

          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Question <%= index + 1 %>
          </h6>
          <h4 class="fw-bold text-dark mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4;">
            <%= q.question %>
          </h4>
          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Correct answer
          </h6>
          <h4 class="fw-bold text-dark mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4;">
            <%= q.correct_answer %>
          </h4>
          <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
            Your answer
          </h6>
          <% if q.correct? %>
            <h4 class="fw-bold mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4 letter-spacing: 1px; color: #81A936;">
          <% else %>
            <h4 class="fw-bold mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4 letter-spacing: 1px; color: #A31621;">
          <% end %>
            <%= q.user_answer %>
          </h4>
          <div class="pt-3 border-top border-light mt-auto">

          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <h3> Test incomplete </h3>
      <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">

          <% @test.questions.each_with_index do |q, index| %>
            <% if index == 0 %>
              <div class="carousel-item active">
            <% else %>
              <div class="carousel-item">
            <% end %>
              <%= render "questions/form", test: @test, question: q %>
            </div>
          <% end %>
        </div>

      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>






  <% end %>
</div>

<style>
  .test-card:first-child {
    display: block !important;
  }
</style>



<style>
  p {
    color: black;
  }
</style>
