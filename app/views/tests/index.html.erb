<div class="container">

  <div class="white_card my-5">
    <p>Select a category to generate quizzes:</p>
    <div class="row row-cols-5 justify-content-center">
      <button class="btn btn-outline-primary m-1">Vocabulary</button>
      <button class="btn btn-outline-primary m-1">Grammar</button>
      <button class="btn btn-outline-primary m-1">Reading</button>
      <button class="btn btn-outline-primary m-1">Kanji</button>
    </div>
    <div class="row row-cols-3 my-3 justify-content-between">
      <button class="btn btn-outline-primary"> Generate Quiz </button>
      <button class="btn btn-outline-primary"> Take Quiz </button>
    </div>
  </div>

  <div>
    <p>Previous results</p>
  </div>
  <div class="overflow-x-scroll mb-5">

    <% @tests.each do |test| %>
      <div class="d-inline-block p-3 border">
        <p> <%= test.title %> </p>
        <p><%= test.category %> </p>
        <p> <%= link_to test.title, test_path(test) %> </p>
      </div>
    <% end %>
  </div>

  <div class="card">
    <%= link_to "New test", new_test_path, class: "btn btn-primary" %>
  </div>
</div>
