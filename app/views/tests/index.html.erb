<div class="container">

  <div class="my-5 bg-white">
    <p>Select a category to generate a new test:</p>
    <div class="row row-cols-5 justify-content-center">
      <button class="btn btn-outline-primary m-1">Vocabulary</button>
      <button class="btn btn-outline-primary m-1">Grammar</button>
      <button class="btn btn-outline-primary m-1">Reading</button>
      <button class="btn btn-outline-primary m-1">Kanji</button>
    </div>
  </div>

  <div class="bg-white">
    <p>Your tests</p>

    <div class="overflow-x-scroll mb-5 bg-white">
      <% @tests.each do |test| %>
        <%= link_to test_path(test) do %>
          <% if test.complete? %>
            <div class="d-inline-block p-3 border border-success border-2">
          <% else %>
            <div class="d-inline-block p-3 border border-2">
          <% end %>
            <p> <%= test.title %> </p>
            <p><%= test.category %> </p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <%= link_to "New test", new_test_path, class: "btn btn-primary" %>
  </div>
</div>
