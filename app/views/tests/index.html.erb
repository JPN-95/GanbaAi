<div class="container pt-3">
  <h1>Tests</h1>

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div class="d-flex align-items-center gap-2">
      <h2 class="mb-0 me-2">Sort by</h2>

      <div class="btn-group">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" style="background-color: #1A70C0; border-color: #1A70C0;">Level</button>
        <ul class="dropdown-menu">
          <li><%= link_to "All Levels", tests_path(category: params[:category], status: params[:status]), class: "dropdown-item" %></li>
          <% ["N1", "N2", "N3", "N4", "N5"].each do |lvl| %>
            <li><%= link_to lvl, tests_path(level: lvl, category: params[:category], status: params[:status]), class: "dropdown-item" %></li>
          <% end %>
        </ul>
      </div>

      <div class="btn-group">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" style="background-color: #1A70C0; border-color: #1A70C0;">Category</button>
        <ul class="dropdown-menu">
          <li><%= link_to "All Categories", tests_path(level: params[:level], status: params[:status]), class: "dropdown-item" %></li>
          <% ["Vocabulary", "Grammar", "Kanji", "Reading"].each do |cat| %>
            <li><%= link_to cat, tests_path(category: cat, level: params[:level], status: params[:status]), class: "dropdown-item" %></li>
          <% end %>
        </ul>
      </div>

      <div class="btn-group">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" style="background-color: #1A70C0; border-color: #1A70C0;">Sort by:</button>
        <ul class="dropdown-menu">
          <li><%= link_to "All", tests_path(status: "All", level: params[:level], category: params[:category]), class: "dropdown-item" %></li>
          <li><%= link_to "Complete", tests_path(status: "Complete", level: params[:level], category: params[:category]), class: "dropdown-item" %></li>
          <li><%= link_to "Incomplete", tests_path(status: "Incomplete", level: params[:level], category: params[:category]), class: "dropdown-item" %></li>
        </ul>
      </div>
    </div>

    <div>
      <%= link_to "New test", new_test_path, class: "btn btn-primary", style: "background-color: #1A70C0; border-color: #1A70C0" %>
    </div>
  </div>

  <%# cards %>
  <div class="row g-4">
  <% @tests.each do |test| %>
    <div class="col-md-6 col-lg-4">
      <div class="position-relative h-100">

          <%# Test link %>
          <%= link_to test_path(test), class: "text-decoration-none h-100 d-block" do %>
            <div class="card h-100 border-0 shadow-sm transition-card bg-white"
                 style="border-radius: 30px; border-top: 6px solid <%= test.complete? ? '#1A936F' : '#A31621' %> !important;">

              <div class="card-body p-4 text-dark">
                <div class="d-flex justify-content-between align-items-center mb-4">
                  <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 1px;">
                      <%= test.level %>
                    </span>
                  </div>
                  <div style="width: 24px;"></div>
                </div>

                <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1.5px;">
                  <%= test.category %>
                </h6>
                <h4 class="fw-bold text-dark mb-4" style="font-family: 'Inter', sans-serif; line-height: 1.4;">
                  <%= test.title %>
                </h4>

                <div class="pt-3 border-top border-light mt-auto">
                  <p class="small mb-0 fw-bold text-uppercase" style="letter-spacing: 1px; color: <%= test.complete? ? '#1A936F' : '#A31621' %>;">
                    <% if test.complete? %>
                      <i class="bi bi-check-circle-fill me-1"></i> Completed
                    <% else %>
                      <i class="bi bi-play-circle-fill me-1"></i> Incomplete
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <%# trash bin %>
          <div class="position-absolute" style="top: 25px; right: 20px; z-index: 10;">
            <%= link_to test_path(test),
                        data: { turbo_method: :delete, turbo_confirm: "Delete the test?"},
                        class: "text-danger p-2" do %>
              <i class="fas fa-trash-alt" style="color: #A31621"></i>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
