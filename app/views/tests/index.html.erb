<div class="container">
  <div class="my-5">
    <p>Select a category to generate a new test:</p>
    <div class="row row-cols-5 justify-content-center">
      <%= link_to "Vocabulary", new_test_path, class: "btn btn-primary mt-5" %>
      <%= link_to "Grammar", new_test_path, class: "btn btn-primary mt-5" %>
      <%= link_to "Reading", new_test_path, class: "btn btn-primary mt-5" %>
      <%= link_to "Kanji", new_test_path, class: "btn btn-primary mt-5" %>
    </div>
    <%= link_to "New test", new_test_path, class: "btn btn-primary mt-5" %>
  </div>
  <div>
    <p> Your quizzes </p>
    <div>
      <% @tests.each do |test| %>
        <%= link_to test_path(test) do %>
          <% if test.complete? %>
            <div class="d-flex flex-row p-2 border border-success border-2 mb-1">
            <% else %>
              <div class="d-flex flex-row p-2 border border-2 mb-1">
              <% end %>
              <div class="p-2 w-100"> <%= test.title %> </div>
              <div class="p-2 flex-shrink-1"><%= test.category %> </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <style>
    a {
      color: black;
      text-decoration: none;
    }
  </style>
