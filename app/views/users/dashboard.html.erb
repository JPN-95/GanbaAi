<div class="container mt-4 mb-5">
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <div class="card shadow-sm text-center p-5"
           style="border-radius: 30px; background-color: #ffffff; border: 1px solid rgba(0,0,0,0.08);">
        <div class="card-body">
          <h1 class="fw-bold text-dark mb-2">GanbaAI Dashboard</h1>
          <% if current_user %>
            <p class="fs-5 text-secondary mb-4">
              Welcome back, <span class="text-primary fw-semibold"><%= current_user.username %></span>.
              You've completed
              <strong class="text-dark">
                <%= @tests.count %> / <%= @total_available_tests %>
              </strong>
              tests so far.
            </p>
          <% end %>
          <%= link_to tests_path, class: "btn btn-primary btn-lg rounded-pill px-5 shadow-sm" do %>
            <i class="bi bi-collection-play me-2"></i>All Tests
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="mt-5">
    <div class="d-flex align-items-center mb-4">
      <h2 class="h4 fw-bold mb-0 text-dark">My Study Stats</h2>
      <div class="ms-3 flex-grow-1 border-top opacity-25"></div>
    </div>
    <div class="row g-4 justify-content-center">
      <% icons = { 'Vocabulary' => 'bi-alphabet', 'Kanji' => 'bi-translate', 'Grammar' => 'bi-spellcheck', 'Reading' => 'bi-book' } %>
      <% ['Vocabulary', 'Kanji', 'Grammar', 'Reading'].each do |category| %>
        <%
          raw_score = @averages[category] || 0
          score = raw_score.round(0)
        %>
        <div class="col-md-3">
          <div class="card h-100 shadow-sm"
               style="border-radius: 20px; background-color: #ffffff; overflow: hidden; border: 1px solid rgba(0,0,0,0.08);">
            <div style="height: 5px; width: 100%; background: #0d6efd;"></div>
            <div class="card-body p-4 text-dark">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-2">
                  <i class="<%= icons[category] %> text-primary fs-4"></i>
                </div>
                <span class="text-muted small fw-bold text-uppercase">
                  <%= pluralize(@tests.where(category: category).count, "Test") %>
                </span>
              </div>
              <h6 class="text-secondary text-uppercase small fw-bold mb-1" style="letter-spacing: 1px;">
                <%= category %>
              </h6>
              <div class="d-flex align-items-baseline">
                <h2 class="fw-bold text-dark mb-0" style="font-size: 2.5rem;">
                  <%= score %>
                </h2>
                <span class="ms-1 text-primary fw-bold fs-4">%</span>
              </div>
              <div class="progress mt-3" style="height: 8px; border-radius: 10px; background-color: #f0f0f0;">
                <div class="progress-bar bg-primary shadow-sm"
                     role="progressbar"
                     style="width: <%= score %>%;"
                     aria-valuenow="<%= score %>"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
              </div>
              <p class="text-muted small mt-3 mb-0">Average Score</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
