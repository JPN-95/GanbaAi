<div class="container">
  <h1>Dashboard</h1>
  <h2>Welcome <%= current_user.username %></h2>
  <%= link_to "All Tests", tests_path, class: "btn btn-primary"%>
</div>
<<div class="dashboard_cards container mt-4">
  <h2 class="mb-4">My Study Stats</h2>
  <div class="row mb-5">
    <% ['vocabulary', 'kanji', 'grammar', 'reading'].each do |category| %>
      <div class="col-md-3">
        <div class="card shadow-sm border-0 text-center">
          <div class="card-body">
            <h6 class="text-muted text-uppercase small"><%= category %></h6>
            <h2 class="display-6 fw-bold mb-0">
              <%= @averages[category] %>%
            </h2>
            <div class="progress mt-2" style="height: 5px;">
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= @averages[category] %>%"></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <h2 class="mb-4">Detailed History</h2>
</div>
<div class="carousel-inner">
  <div class="dashboard_cards container mt-4">
    <h2 class="mb-4">Vocabulary</h2>
    <div id="vocabulary" class="carousel slide" data-bs-ride="false">
      <div class="carousel-inner">
        <% @tests.in_groups_of(3, false).each_with_index do |group, index| %>
          <div class="carousel-item <%= 'active' if index == 0 %>">
            <div class="row">
              <% group.each do |test| %>
                <div class="col-md-4">
                  <div class="card text-bg-primary mb-3">
                    <div class="card-header"><%= test&.category&.capitalize %></div>
                    <div class="card-body">
                      <h5 class="card-title text-truncate"><%= test.title %></h5>
                      <p class="card-text">Questions: <%= test.questions.count %></p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#vocabulary" data-bs-slide="prev">
        <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#vocabulary" data-bs-slide="next">
        <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  </div>
  <div id="carouselExample" class="carousel slide" data-bs-ride="false">
    <div class="carousel-inner">
      <div class="dashboard_cards container mt-4">
