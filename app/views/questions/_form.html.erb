<div>
  <div>
    <span>Q<%= local_assigns[:index] || "1" %>.</span>
    <p>Select the best option:</p>
  </div>
  <div>
    <h2><%= question.question %></h2>
    <% if question.respond_to?(:translation) && question.translation.present? %>
      <p><%= question.translation %></p>
    <% end %>
  </div>
  <%= simple_form_for [test, question] do |f| %>
    <%= f.input :user_answer,
                collection: question.generated_answers,
                as: :radio_buttons,
                label: false,
                item_wrapper_class: 'option-item',
                item_label_class: 'option-label' %>
    <div>
      <%= f.submit "Submit Answer" %>
    </div>
  <% end %>
</div>
